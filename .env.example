# UBAA.Server 环境变量示例
# 复制为 .env 后按需修改；不要提交真实 .env。

# 服务监听
SERVER_BIND_HOST=0.0.0.0
SERVER_PORT=5432

# SQLite / FreeCache
SQLITE_PATH=data/ubaa-server.db
FREECACHE_SIZE_MB=64

# 版本与更新
# 默认版本在源码中与 UBAA 主仓库对齐；这里通常无需覆盖。
UBAA_SERVER_VERSION=
UBAA_SERVER_VERSION_CODE=
UBAA_SERVER_COMMIT=
UBAA_SERVER_BUILD_TIME=
UPDATE_DOWNLOAD_URL=https://github.com/BUAASubnet/UBAA/releases

# 安全配置
# 生产环境必须替换为足够长、不可预测的随机值。
JWT_SECRET=your_jwt_secret_here

# 运行时实例标识与反向代理集成
INSTANCE_ID=ubaa-server-1
ENABLE_FORWARDED_HEADERS=true
CORS_ALLOWED_ORIGINS=

# 认证令牌/会话生命周期
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=7
SESSION_TTL_DAYS=7
PRELOGIN_TTL_MINUTES=5

# 认证韧性调优
LOGIN_MAX_CONCURRENCY=6
AUTH_VALIDATION_TIMEOUT_MS=3000
AUTH_PRELOAD_TIMEOUT_MS=3000
AUTH_LOGIN_TIMEOUT_MS=18000

# 上游访问
USE_VPN=false
TRUST_ALL_CERTS=false

# BYKC 调试日志
# 可能输出个人课程数据，仅在临时排障时开启。
BYKC_DEBUG_RAW_API_LOG=false
BYKC_DEBUG_PARSED_COURSE_LOG=false
